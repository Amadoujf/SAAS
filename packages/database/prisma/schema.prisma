// YamaCommerce AI — schéma de base de données
// Voir docs/04-schema-base-de-donnees.md pour le contexte et docs/03-architecture-technique.md
// pour la stratégie multi-tenant (DB partagée + tenantId + Row-Level Security).
//
// Convention d'isolation : toute table métier porte `tenantId`. Les contraintes d'unicité
// sont composées avec `tenantId`. L'activation de RLS se fait dans une migration SQL dédiée
// (prisma/migrations/.../migration.sql), Prisma ne modélisant pas les policies nativement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // `url` : connexion utilisée par Prisma Client à l'exécution — rôle applicatif
  // restreint (yamacommerce_app), soumis à Row-Level Security.
  url       = env("DATABASE_URL")
  // `directUrl` : connexion utilisée uniquement par `prisma migrate` / `prisma studio`,
  // propriétaire des tables (yamacommerce_owner) — nécessaire pour créer les tables et
  // les policies RLS. Voir docs/03-architecture-technique.md §3.2 et .env.example.
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ============================================================================
// PLATEFORME
// ============================================================================

enum BusinessType {
  ECOMMERCE
  RESTAURANT
  REAL_ESTATE
  AUTOMOBILE
  SALON
  HOTEL
  SCHOOL
  SERVICES
  DELIVERY
  WHOLESALE
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

model Tenant {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  businessType     BusinessType // legacy Phase 0 — conservé pour compatibilité d'affichage,
  // remplacé fonctionnellement par `sectorKey` (registre secteurs, voir docs/11).
  sectorKey        String? // clé vers Sector.key — null tant que le tenant n'a pas terminé
  // l'assistant de création (choix du secteur, voir docs/09 Phase 1).
  sector           Sector?      @relation(fields: [sectorKey], references: [key])
  status           TenantStatus @default(PENDING)
  branding         Json         @default("{}") // { logoUrl, primaryColor, secondaryColor, defaultMode }
  currency         String       @default("XOF")
  locale           String       @default("fr") // fr | en | wo
  supportedLocales String[]     @default(["fr"])
  timezone         String       @default("Africa/Dakar")
  trialEndsAt      DateTime?
  /// Dérogation Super Admin EXPLICITE pour un tenant antérieur à la facturation SaaS
  /// (voir docs/14, « aucune souscription = accès illimité » — corrigé le 22
  /// septembre 2026) : SEUL un tenant marqué ici échappe encore au blocage par défaut
  /// lorsqu'aucun `TenantSubscription` n'existe. `null` = aucune dérogation (nouveau
  /// tenant standard) — jamais l'inverse, jamais un défaut permissif.
  billingExemptedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  domains                  Domain[]
  users                    TenantUser[]
  invitations              TenantInvitation[]
  storefrontContent        StorefrontContent?
  roles                    Role[]
  shops                    Shop[]
  categories               Category[]
  products                 Product[]
  productVariants          ProductVariant[]
  inventoryItems           InventoryItem[]
  stockMovements           StockMovement[]
  customers                Customer[]
  customerAddresses        CustomerAddress[]
  carts                    Cart[]
  cartItems                CartItem[]
  orders                   Order[]
  orderItems               OrderItem[]
  orderStatusHistory       OrderStatusHistory[]
  paymentWebhookEvents     PaymentWebhookEvent[]
  deliveries               Delivery[]
  invoices                 Invoice[]
  quotes                   Quote[]
  subscription             TenantSubscription?
  subscriptionPayments     SubscriptionPayment[]
  subscriptionEvents       SubscriptionEvent[]
  subscriptionEntitlements SubscriptionEntitlement[]
  subscriptionUsages       SubscriptionUsage[]
  billingCheckoutSessions  BillingCheckoutSession[]
  auditLogs                AuditLog[]
  paymentConfigs           PaymentProviderConfig[]
  whatsappConfig           WhatsAppConfig?
  deliveryZones            DeliveryZone[]
  commerceSettings         CommerceSettings?
  notificationLogs         NotificationLog[]
  deliverers               Deliverer[]
  counters                 Counter[]
  aiJobs                   AIGenerationJob[]
  aiUsageRecords           AIUsageRecord[]
  importJobs               ImportJob[]
  notifTemplates           NotificationTemplate[]
  suppliers                Supplier[]
  expenses                 Expense[]
  promoCodes               PromoCode[]
  giftCards                GiftCard[]
  impersonated             ImpersonationSession[]
  tenantModules            TenantModule[]
  tenantSite               TenantSite?
  siteVersions             TenantSiteVersion[]
  pages                    Page[]
  mediaAssets              MediaAsset[]

  @@index([status])
}

/// Cycle de vie complet d'un domaine — voir docs/13 (assistant de domaines
/// personnalisés, 16 septembre 2026), « STATUTS DU DOMAINE ». Remplace les trois
/// anciens statuts épars (`verified`/`verificationStatus`/`sslStatus`/`status`) par
/// UN SEUL champ faisant foi, pour qu'il n'existe jamais de combinaison
/// contradictoire (ex. "verified=true" mais "sslStatus=pending" sans distinguer si
/// c'est normal ou bloqué).
///
/// DRAFT : domaine saisi, pas encore de jeton généré. PENDING_DNS : jeton généré,
/// instructions affichées, aucun enregistrement détecté. VERIFYING : au moins une
/// tentative de détection DNS a eu lieu. VERIFIED : propriété confirmée (TXT trouvé),
/// certificat pas encore demandé. SSL_PENDING : certificat en cours d'émission.
/// ACTIVE : certificat émis, domaine réellement servi — voir « Ne jamais afficher un
/// domaine comme actif avant que le HTTPS fonctionne réellement ». MISCONFIGURED :
/// une configuration valide a été détectée puis cassée (ou n'a jamais abouti après de
/// nombreuses tentatives). SUSPENDED : action Super Admin. EXPIRED : domaine
/// géré par la plateforme dont l'échéance est dépassée. REMOVED : retiré par le
/// client ou un Super Admin — la ligne est conservée pour l'audit, jamais supprimée.
enum DomainLifecycleStatus {
  DRAFT
  PENDING_DNS
  VERIFYING
  VERIFIED
  SSL_PENDING
  ACTIVE
  MISCONFIGURED
  SUSPENDED
  EXPIRED
  REMOVED
}

model Domain {
  id                          String  @id @default(uuid())
  tenantId                    String
  tenant                      Tenant  @relation(fields: [tenantId], references: [id])
  domain                      String  @unique // contrainte d'unicité globale : un domaine ne peut jamais
  // appartenir à deux tenants à la fois — voir docs/09, Phase 1 (« domaine personnalisé »).
  type                        String // "subdomain" | "custom"
  isPrimary                   Boolean @default(false)
  /// Voir @yamacommerce/domains `domain-redirect.ts` : un domaine non-principal
  /// redirige TOUJOURS directement vers le principal du tenant, SAUF s'il porte ce
  /// drapeau (posé sur le sous-domaine gratuit — « conserver le sous-domaine comme
  /// adresse de secours après connexion d'un domaine personnalisé »).
  serveDirectlyWhenNotPrimary Boolean @default(false)

  lifecycleStatus DomainLifecycleStatus @default(DRAFT)

  // --- Vérification de propriété -------------------------------------------
  /// Voir « VÉRIFICATION DE PROPRIÉTÉ » : aléatoire, lié à ce tenant+domaine par cette
  /// seule ligne, expirable, renouvelable (régénéré = ancien jeton immédiatement
  /// invalide). Jamais journalisé dans un message d'erreur public.
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  verificationAttempts       Int       @default(0)
  /// Enregistrements DNS attendus, affichés au commerçant dans l'assistant de
  /// configuration : [{ type: "CNAME"|"A"|"TXT", host, value, ttlSeconds }].
  expectedDnsRecords         Json?     @default("[]")
  /// Dernier relevé DNS constaté par la détection automatique périodique.
  detectedDnsRecords         Json?
  lastCheckedAt              DateTime?
  /// Horodatage du dernier rappel envoyé si la configuration reste incomplète.
  incompleteReminderSentAt   DateTime?

  // Abstraction du fournisseur de domaine (adjustement #5) : permet de migrer de Caddy
  // (on-demand TLS, dev/premiers déploiements) vers Cloudflare Custom Hostnames sans
  // changer le modèle de données ni le code appelant — voir packages/domains.
  dnsProvider          String  @default("caddy") // caddy | cloudflare_custom_hostname | local
  cloudflareHostnameId String?

  // --- Domaine géré par la plateforme (achat + registrar) --------------------
  /// Voir « DOMAINE GÉRÉ PAR LA PLATEFORME » : le titulaire légal reste TOUJOURS le
  /// client (`legalOwnerName`/`legalOwnerContact`), même quand la plateforme
  /// administre techniquement le domaine.
  managedByPlatform   Boolean   @default(false)
  registrarProvider   String? // "opensrs" | "manual" | null — voir @yamacommerce/domains `registrar-provider.ts`.
  externalRegistrarId String?
  purchasedAt         DateTime?
  expiresAt           DateTime?
  autoRenew           Boolean   @default(false)
  purchaseCostXOF     Int? // ce que la plateforme a payé au registrar.
  priceBilledXOF      Int? // ce qui est facturé au client.
  paymentStatus       String? // "paid" | "pending" | "failed" | null.
  legalOwnerName      String?
  legalOwnerContact   Json?
  transferStatus      String? // "none" | "pending" | "completed" | "failed" | null.
  isLocked            Boolean   @default(true) // verrou de transfert registrar (protection anti-vol).

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([lifecycleStatus])
}

// ============================================================================
// FACTURATION SAAS — abonnements des ENTREPRISES à la plateforme (19 septembre 2026).
// Entièrement distinct des paiements des CLIENTS FINAUX sur le site d'une entreprise
// (voir packages/payments, modèles Payment/PaymentProviderConfig/PaymentWebhookEvent,
// jamais touchés ici). `SubscriptionPlan`/`TenantSubscription` renommés depuis
// `Plan`/`Subscription` (Phase 0) — additif, jamais un modèle parallèle : ces deux
// modèles sont déjà utilisés en production par `real-media-context.ts` (quota
// médiathèque) et `readiness-resolver.ts`/`@yamacommerce/publishing` `readiness.ts`
// (blocage de publication) — voir ces fichiers pour la mise à jour de concert.
// ============================================================================

enum PlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// `AUTOMATIC` reste RÉSERVÉ au schéma mais structurellement impossible à activer :
/// aucun adaptateur de `packages/billing` n'implémente aujourd'hui un mandat de
/// paiement récurrent conforme (Chariow ne prélève jamais sans confirmation explicite
/// du client à chaque paiement) — voir docs/14-facturation-saas-abonnements.md.
enum RenewalMode {
  MANUAL
  AUTOMATIC
}

model SubscriptionPlan {
  id                  String     @id @default(uuid())
  name                String     @unique // Essentiel, Business, Premium, Entreprise
  status              PlanStatus @default(DRAFT)
  currency            String     @default("XOF")
  priceMonthly        Int
  priceYearly         Int
  trialDays           Int        @default(14)
  /// Durée en JOURS entiers (pas d'arithmétique calendaire mois/année — aucune
  /// librairie de dates dans ce projet, cohérent avec le reste du schéma qui utilise
  /// déjà des jours entiers partout ailleurs).
  monthlyDurationDays Int        @default(30)
  yearlyDurationDays  Int        @default(365)
  /// Jours de grâce après `currentPeriodEnd` avant suspension — voir
  /// `subscription-status.ts`, transition ACTIVE -> GRACE_PERIOD -> SUSPENDED.
  gracePeriodDays     Int        @default(3)
  /// Frais de mise en service ponctuel, facturé une seule fois à la première
  /// souscription — `null` = aucun frais.
  setupFeeXOF         Int?

  maxProducts                 Int
  maxEmployees                Int
  maxShops                    Int
  storageMB                   Int
  customDomainAllowed         Boolean @default(false)
  /// Quota par NOMBRE de domaines personnalisés — conservé EN PLUS de
  /// `customDomainAllowed` (compat) : ce dernier reste un simple interrupteur,
  /// celui-ci une vraie limite dénombrable.
  maxCustomDomains            Int     @default(1)
  /// Quotas mensuels e-mail/WhatsApp — `null` = illimité. Suivis via
  /// `SubscriptionUsage` (resourceKey "emails"/"whatsapp_messages"), voir
  /// subscription-usage.ts : ce sont les SEULES ressources sans table source propre
  /// à compter en direct (contrairement aux produits/employés/domaines).
  maxEmailsPerMonth           Int?
  maxWhatsAppMessagesPerMonth Int?
  // Limites de la médiathèque (voir docs/12 §12.2, « médiathèque R2 », 21 septembre
  // 2026) — `storageMB` ci-dessus reste le quota TOTAL de stockage ; ces 4 champs
  // couvrent les limites complémentaires explicitement demandées : taille maximale
  // par image/vidéo/document, nombre maximal de fichiers, quota mensuel d'importation.
  // "Entreprise" reste une valeur par défaut généreuse, ajustable au cas par cas
  // (même convention que `maxProducts`/`maxEmployees` pour cette formule).
  maxImageFileMB              Int     @default(10)
  maxVideoFileMB              Int     @default(200)
  maxDocumentFileMB           Int     @default(10)
  maxMediaFileCount           Int     @default(2000)
  monthlyUploadMB             Int     @default(2048)
  advancedReports             Boolean @default(false)
  whatsappAutomation          Boolean @default(false)
  commissionRate              Decimal @default(0) @db.Decimal(5, 2) // % prélevé sur les ventes

  // Limites IA par formule (adjustement #8)
  maxAIGenerationsPerMonth      Int
  maxAIImagesAnalyzedPerMonth   Int
  maxAIProductsImportedPerMonth Int
  aiEstimatedCostCapXOF         Int? // seuil d'alerte de coût, null = pas de plafond

  /// Modules sectoriels inclus par cette formule, en plus des modules par défaut du
  /// secteur choisi — voir docs/11-secteurs-et-modules.md §11.1 et modèle TenantModule.
  includedModuleKeys String[] @default([])

  features Json    @default("[]")
  isActive Boolean @default(true)
  /// Formule « sur devis » (ex. Sur mesure) : jamais souscrite en libre-service, jamais
  /// envoyée au checkout — le prix est négocié et la formule attribuée par un Super Admin.
  isQuoteOnly Boolean @default(false)

  /// Mode de renouvellement par défaut des abonnements souscrits à cette formule —
  /// copié sur `TenantSubscription.renewalMode` à la souscription (voir RenewalMode).
  renewalMode             RenewalMode @default(MANUAL)
  /// Identifiants produit Chariow correspondants — PAS un secret (juste une
  /// référence), administrable par le Super Admin, jamais codé en dur.
  chariowMonthlyProductId String?
  chariowYearlyProductId  String?

  subscriptions TenantSubscription[]
}

/// PENDING : abonnement créé, aucun paiement confirmé pour l'instant (avant la
/// première session Chariow). TRIALING : essai gratuit à l'inscription (conservé tel
/// quel, RÉEL et déjà utilisé par le parcours d'inscription — voir seed.ts).
/// ACTIVE : payé et à jour. GRACE_PERIOD : `currentPeriodEnd` dépassé mais dans la
/// fenêtre de grâce de la formule — service inchangé. PAST_DUE : réservé à un futur
/// signal "tentative de paiement échouée" (aucun événement Chariow ne le déclenche
/// pour l'instant — jamais atteint par le flux normal de cette étape, seulement par
/// une future extension ou une action Super Admin manuelle). SUSPENDED : grâce
/// dépassée, site public en page de suspension facturation (jamais de suppression de
/// données). CANCELED : annulation explicite (tenant ou Super Admin). EXPIRED :
/// suspendu depuis longtemps sans réactivation (voir docs/14 pour le seuil exact).
enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  /// Copié depuis `SubscriptionPlan.renewalMode` à la souscription — voir RenewalMode.
  renewalMode        RenewalMode        @default(MANUAL)
  /// `@db.Timestamptz(3)` DÉLIBÉRÉMENT explicite sur les 4 champs temporels
  /// ci-dessous : ce sont ceux comparés à `NOW()`/entre eux par la formule de
  /// renouvellement et la machine à états (voir `subscription-registry.ts`,
  /// `subscription-status.ts`) — même leçon que `Order.reservationExpiresAt`
  /// (migration `20260927000000_reservation_expiry_timestamptz`) : un `timestamp`
  /// sans fuseau aurait réintroduit exactement le même bug de comparaison
  /// dépendante du fuseau de session Postgres. `createdAt`/`canceledAt` restent de
  /// simples horodatages d'audit, jamais comparés — pas besoin du même traitement.
  currentPeriodStart DateTime           @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false)
  graceEndsAt        DateTime?          @db.Timestamptz(3)
  suspendedAt        DateTime?          @db.Timestamptz(3)
  canceledAt         DateTime?
  /// Pointeur dénormalisé vers le DERNIER paiement ayant confirmé/prolongé la
  /// période courante — confort de lecture dashboard, jamais la source de vérité
  /// (celle-ci reste `SubscriptionPayment`/`SubscriptionEvent`).
  lastPaymentId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments SubscriptionPayment[]
  events   SubscriptionEvent[]

  @@index([tenantId])
  @@index([status])
}

model SubscriptionPayment {
  id                  String             @id @default(uuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  subscriptionId      String
  subscription        TenantSubscription @relation(fields: [subscriptionId], references: [id])
  planId              String
  checkoutSessionId   String?
  provider            String // "chariow" | "manual"
  /// Unique PAR PRESTATAIRE — un webhook Chariow rejoué (même vente) ne crée jamais
  /// un second paiement ni ne prolonge deux fois l'abonnement (voir
  /// subscription-registry.ts, `confirmSubscriptionPaymentSuccess`).
  providerSaleId      String?
  amountXOF           Int
  currency            String             @default("XOF")
  status              String             @default("PENDING") // PENDING | SUCCEEDED | FAILED
  /// Nombre de jours dont la période a été prolongée par CE paiement — calculé au
  /// moment de la confirmation, jamais recalculé après coup (immuable dans les faits,
  /// bien que la table reste mutable pour la transition de statut PENDING -> autre,
  /// même précédent que `Payment` côté commerce, PAS un REVOKE ici).
  periodExtensionDays Int?
  rawPayload          Json?
  createdAt           DateTime           @default(now())
  confirmedAt         DateTime?

  @@unique([provider, providerSaleId])
  @@index([tenantId])
  @@index([subscriptionId])
}

/// Journal d'audit APPEND-ONLY — REVOKE UPDATE/DELETE en migration (même précédent
/// que StockMovement/OrderStatusHistory) : chaque événement de facturation SaaS doit
/// rester consultable et non falsifiable, y compris les événements INVALIDES/rejetés
/// (webhook mal signé, montant incohérent, tentative cross-tenant).
model SubscriptionEvent {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  subscriptionId  String?
  subscription    TenantSubscription? @relation(fields: [subscriptionId], references: [id])
  type            String // ex. "checkout_created" | "payment_succeeded" | "renewed" | "suspended" | "manual_extension" | "webhook_rejected_invalid_signature" | "webhook_rejected_cross_tenant"
  actorType       String // "system" | "webhook" | "super_admin" | "tenant_owner"
  actorUserId     String?
  /// Obligatoire en couche APPLICATIVE (pas une contrainte schéma) pour toute action
  /// Super Admin manuelle — voir docs/14, « prolongation manuelle avec justification
  /// obligatoire ».
  justification   String?
  payloadSnapshot Json?
  createdAt       DateTime            @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
}

/// Dérogations/overrides Super Admin par rapport aux quotas de la formule — JAMAIS
/// une copie redondante des quotas de `SubscriptionPlan` (leçon de cette session :
/// jamais un état à resynchroniser). Absence de ligne = aucune dérogation, le quota
/// effectif est celui de la formule seule.
model SubscriptionEntitlement {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  resourceKey String // "records" (fiches) | "employees" | "domains" | "emails" | "whatsapp_messages" | ...
  limitValue  Int? // null = illimité pour cette dérogation
  resetPeriod String    @default("none") // "monthly" | "none"
  reason      String?
  grantedBy   String?
  expiresAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, resourceKey])
  @@index([tenantId])
}

/// Compteurs d'usage CUMULATIFS sans table source propre à compter en direct — voir
/// `subscription-usage.ts` : les ressources dénombrables via une vraie table
/// (produits, employés, domaines) sont comptées EN DIRECT (`tx.product.count(...)`),
/// jamais dupliquées ici. Même forme que `AIUsageRecord` déjà existant, généralisée
/// par `resourceKey` plutôt qu'une colonne dédiée par dimension.
model SubscriptionUsage {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  resourceKey String // "emails" | "whatsapp_messages"
  periodKey   String // "2026-09"
  usedValue   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, resourceKey, periodKey])
  @@index([tenantId])
}

/// Corrélation checkout Chariow <-> webhook Pulse — voir docs/14, « jamais d'accès
/// accordé depuis la redirection navigateur » : `internalReference` est le jeton
/// aléatoire non devinable transmis via `custom_metadata`, retrouvé par le webhook
/// pour confirmer QUELLE session a réellement été payée.
model BillingCheckoutSession {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  subscriptionId     String?
  planId             String
  billingCycle       BillingCycle
  provider           String // "chariow" | "manual"
  providerCheckoutId String?
  /// Jeton aléatoire non devinable — voir la note de tête de modèle.
  internalReference  String       @unique
  status             String       @default("PENDING") // PENDING | CONFIRMED | EXPIRED | CANCELED
  amountXOF          Int
  currency           String       @default("XOF")
  /// `@db.Timestamptz(3)` : comparé à `NOW()` par le balayage de rapprochement
  /// (sessions restées PENDING au-delà de leur échéance) — même précédent que
  /// `TenantSubscription`, voir la note ci-dessus.
  expiresAt          DateTime     @db.Timestamptz(3)
  createdAt          DateTime     @default(now())

  @@index([tenantId])
}

// ============================================================================
// REGISTRE SECTEURS / MODULES (Phase 1 — voir docs/11-secteurs-et-modules.md)
// ============================================================================

/// Un secteur d'activité (e-commerce, immobilier, voyage, ... ou "custom" pour
/// « Autre activité »). Les secteurs "système" (isSystem = true) sont fournis par la
/// plateforme ; un Super Admin peut en créer d'autres sans déploiement (isSystem =
/// false) — voir docs/11 §11.7.2. Composer un nouveau secteur ne peut se faire qu'à
/// partir de modules et de pages déjà existants : aucun code n'est requis.
model Sector {
  id                     String   @id @default(uuid())
  key                    String   @unique // ecommerce | fashion | restaurant | ... | custom
  name                   String
  iconKey                String?
  vocabulary             Json     @default("{}") // { "catalog": "Biens", "item": "Bien", ... }
  description            String?
  defaultModuleKeys      String[]
  optionalModuleKeys     String[] @default([])
  compatibleTemplateTags String[] @default([])
  proposedPageManifest   Json     @default("[]")
  customFieldSchema      Json?
  isSystem               Boolean  @default(true)
  isActive               Boolean  @default(true)
  /// Secteur réellement opérationnel (templates, fonctions métier et dashboard livrés
  /// et testés) — seuls ceux-ci sont proposés à la création d'entreprise ; les autres
  /// sont présentés « À venir », jamais vendus.
  isAvailable            Boolean  @default(false)
  createdBy              String?
  createdAt              DateTime @default(now())

  tenants       Tenant[]
  siteTemplates SiteTemplate[]
}

/// Un module fonctionnel activable — soit "core" (fourni à tous, non désactivable),
/// soit "sector" (rattaché à un ou plusieurs secteurs, activable/désactivable).
model Module {
  id          String   @id @default(uuid())
  key         String   @unique // ex. "catalog", "listings", "appointments"
  name        String
  category    String // "core" | "sector"
  sectorKeys  String[] // secteurs auxquels ce module sectoriel s'applique ([] si core)
  description String?
  createdAt   DateTime @default(now())
}

/// Activation d'un module pour un tenant donné — voir docs/11 §11.6 (règle de
/// gouvernance). Un module absent de cette table pour un tenant est considéré désactivé.
model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  moduleKey String
  isEnabled Boolean  @default(true)
  source    String // "sector_default" | "manual" | "plan_included"
  config    Json?
  enabledAt DateTime @default(now())

  @@unique([tenantId, moduleKey])
  @@index([tenantId, isEnabled])
}

// ============================================================================
// REGISTRE DES TEMPLATES (Phase 1 — voir docs/12-systeme-templates-et-direction-artistique.md)
// ============================================================================

/// Un template de site — appartient à un secteur, jamais de données métier à
/// l'intérieur (voir docs/12 §12.1). `pageManifest` et `defaultDesignTokens` sont
/// validés côté application via @yamacommerce/templates et @yamacommerce/design-tokens
/// avant toute écriture — voir packages/database/src/templates-registry.ts.
model SiteTemplate {
  id                    String   @id @default(uuid())
  key                   String   @unique // identifiant stable, ex. "ecommerce-luxury-minimal"
  name                  String
  sectorKey             String
  sector                Sector   @relation(fields: [sectorKey], references: [key])
  description           String?
  artDirectionKey       String
  previewImageUrl       String?
  /// TemplateManifest complet (pages + sections avec leurs instances) — voir
  /// @yamacommerce/templates.
  pageManifest          Json
  /// Sections que ce template sait utiliser (peut être plus large que celles déjà
  /// posées dans pageManifest — utile à l'éditeur pour proposer un ajout).
  availableSectionKeys  String[] @default([])
  requiredModuleKeys    String[] @default([])
  optionalModuleKeys    String[] @default([])
  /// DesignTokens complet par défaut — voir @yamacommerce/design-tokens.
  defaultDesignTokens   Json
  defaultAnimationLevel String   @default("dynamic") // discreet | dynamic | immersive
  status                String   @default("draft") // draft | published | archived
  version               Int      @default(1)
  mobileCompatible      Boolean  @default(true)
  demoData              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenantSites TenantSite[]

  @@index([sectorKey, status])
}

/// Le site d'une entreprise : quel template, avec quelle surcharge de tokens. Ne porte
/// JAMAIS de données métier (produits, commandes, clients) — voir docs/12 §12.1,
/// garantie que changer de template ne supprime rien.
model TenantSite {
  id                     String       @id @default(uuid())
  tenantId               String       @unique
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])
  templateId             String
  template               SiteTemplate @relation(fields: [templateId], references: [id])
  /// Surcharge partielle — voir @yamacommerce/design-tokens `DesignTokensOverrides`.
  /// Ne modifie jamais `SiteTemplate.defaultDesignTokens` : la fusion est calculée à la
  /// volée par `resolveEffectiveDesignTokens()`.
  designTokenOverrides   Json         @default("{}")
  animationLevelOverride String? // null = hérite de SiteTemplate.defaultAnimationLevel
  isPublished            Boolean      @default(false)
  publishedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  versions TenantSiteVersion[]
}

/// Historique de versions de l'éditeur visuel — voir docs/12 §12.2 (« brouillons »,
/// « historique / annuler-rétablir », « publication programmée ») et
/// docs/04 §4.5.7. Chaque version porte son propre jeu complet de `Page` : publier ne
/// modifie jamais une version existante, elle en fige une nouvelle et archive
/// l'ancienne — c'est ce qui donne l'historique/restauration "gratuitement".
///
/// `tenantId` est dénormalisé depuis `TenantSite.tenantId` (au lieu d'une policy RLS
/// qui remonterait par jointure) pour suivre exactement le même Pattern A que le reste
/// du schéma (voir docs/04 §4.4) — une politique RLS directe sur une colonne locale,
/// jamais une jointure implicite dans la clause USING.
model TenantSiteVersion {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantSiteId String
  tenantSite   TenantSite @relation(fields: [tenantSiteId], references: [id])
  status       String     @default("draft") // draft | scheduled | published | archived
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Numéro séquentiel par site (voir @yamacommerce/database `nextCounterValue`,
  /// scope `site-version-{tenantSiteId}`) — attribué UNIQUEMENT au moment de la
  /// publication effective (`publishVersion`), jamais sur un simple brouillon : c'est
  /// le numéro affiché dans l'historique ("Version 12"), pas un id de ligne.
  versionNumber  Int?
  /// Message facultatif saisi par le publieur — voir docs/12 §12.3, "message facultatif".
  publishMessage String?
  /// Figé au moment de la publication par `computeChangesSummary`
  /// (@yamacommerce/publishing) — jamais recalculé a posteriori, voir la note de tête
  /// de fichier de `changes-summary.ts` sur l'immuabilité d'une version publiée.
  changesSummary Json?
  /// Domaine/sous-domaine effectivement servi par CETTE version au moment de sa
  /// publication (peut différer d'une version à l'autre si le domaine a changé depuis).
  domainUsed     String?
  /// Vrai si cette version a été publiée via une publication PROGRAMMÉE (le job
  /// `site-publishing`) plutôt qu'un clic direct sur "Publier maintenant".
  wasScheduled   Boolean @default(false)

  /// Restauration : voir docs/12 §12.3, "Une restauration doit créer une nouvelle
  /// version. Elle ne doit jamais modifier l'ancienne." — trace UNIQUEMENT quelle
  /// version archivée a servi de source, ne modifie jamais cette source.
  restoredFromVersionId String?
  restoredFrom          TenantSiteVersion?  @relation("VersionRestoredFrom", fields: [restoredFromVersionId], references: [id])
  restoredInto          TenantSiteVersion[] @relation("VersionRestoredFrom")
  /// Justification obligatoire uniquement quand la restauration est effectuée par un
  /// Super Admin (voir docs/12 §12.3, "SUPER ADMIN" : "restaurer une version avec
  /// justification obligatoire") — null pour une restauration normale par le tenant.
  restoreJustification  String?

  pages Page[]

  @@index([tenantSiteId, status])
  @@index([tenantId])
}

/// Une page au sein d'une version — voir docs/04 §4.5.7 : remplace le placeholder
/// `Page.tenantSiteId` de la Phase 0 par `Page.tenantSiteVersionId`. `blocks` porte un
/// tableau de `SectionInstance` (voir @yamacommerce/templates) — jamais écrit sans
/// validation préalable (même garantie que `SiteTemplate.pageManifest`).
model Page {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  tenantSiteVersionId String
  tenantSiteVersion   TenantSiteVersion @relation(fields: [tenantSiteVersionId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  isHome              Boolean           @default(false)
  blocks              Json              @default("[]")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([tenantSiteVersionId, slug])
  @@index([tenantId])
}

// ============================================================================
// MÉDIATHÈQUE (voir docs/12 §12.2, « médiathèque R2 », 21 septembre 2026)
// ============================================================================

enum MediaAssetType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// PENDING : URL de dépôt créée, fichier pas encore reçu/vérifié — jamais utilisable
/// dans l'éditeur à ce stade (voir la garantie « aucun accès public à un fichier non
/// vérifié »). READY : vérifié, variantes générées si applicable. FAILED : rejeté par
/// `validateUploadedFile` (voir @yamacommerce/storage) — conservé brièvement pour
/// audit, jamais listé dans la médiathèque. TRASHED : dans la corbeille (suppression
/// différée, voir « Suppression »).
enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  TRASHED
}

/// Un média importé par un tenant — voir docs/12 §12.2. `storageKey` est TOUJOURS
/// préfixée par le tenant (voir @yamacommerce/storage `buildStorageKey`) : cette
/// colonne n'est JAMAIS envoyée telle quelle au navigateur (voir « les clés R2 ne
/// doivent jamais être envoyées au navigateur ») — seules des URLs signées
/// temporaires ou l'URL CDN publique d'une variante le sont.
///
/// `variants` porte les dérivés générés (miniature/petite/moyenne/grande/original
/// optimisé, voir @yamacommerce/storage `image-variants.ts`) sous la forme
/// `[{ key, storageKey, width, height, format, sizeBytes }]` — jamais de pixels ici,
/// uniquement des références de stockage. `referenceCount` est un CACHE recalculé par
/// `refreshMediaReferenceCount()` (voir lib/editor/media-references.ts côté
/// application, qui scanne les pages via les schémas de section déjà génériques) —
/// jamais mis à jour de façon fiable à chaque frappe dans l'éditeur, ce serait un
/// couplage bien plus fragile qu'un recalcul explicite avant suppression/affichage.
model MediaAsset {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  originalName    String
  storageKey      String           @unique
  type            MediaAssetType
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Float?
  altText         String?
  caption         String?
  folder          String           @default("")
  status          MediaAssetStatus @default(PENDING)
  isPublic        Boolean          @default(false)
  checksumSha256  String
  importedAt      DateTime         @default(now())
  deletedAt       DateTime?
  metadata        Json             @default("{}")
  referenceCount  Int              @default(0)
  variants        Json             @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  productImages ProductImage[]

  @@index([tenantId, status])
  @@index([tenantId, folder])
  @@index([tenantId, checksumSha256])
  @@index([tenantId, deletedAt])
}

// ============================================================================
// IDENTITÉ & ACCÈS
// ============================================================================

model User {
  id               String    @id @default(uuid())
  email            String?   @unique
  phone            String?   @unique
  passwordHash     String
  fullName         String
  isSuperAdmin     Boolean   @default(false)
  preferredLocale  String    @default("fr")
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships      TenantUser[]
  impersonations   ImpersonationSession[] @relation("SuperAdminActor")
  ownedMediaAssets MediaAsset[]
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // null = rôle système global fourni par la plateforme
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  isSystem    Boolean  @default(false)
  permissions String[] // clés de permission, ex. "orders.update_status"
  createdAt   DateTime @default(now())

  memberships TenantUser[]

  @@unique([tenantId, name])
}

enum TenantUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model TenantUser {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id])
  status    TenantUserStatus @default(INVITED)
  invitedBy String?
  joinedAt  DateTime?
  createdAt DateTime         @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Contenus mis en avant sur l'accueil de la boutique (carrousel, univers, sélection,
/// collections, bandeau) — structure validée côté serveur par un schéma Zod
/// (apps/web/lib/storefront/home-content.ts) avant tout enregistrement.
model StorefrontContent {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  content   Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Invitation d'un membre de l'équipe. Le jeton n'est JAMAIS stocké en clair (seule
/// son empreinte SHA-256) ; une invitation en attente compte dans le quota
/// d'utilisateurs de la formule, comme un membre actif.
model TenantInvitation {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  email       String
  roleName    String
  tokenHash   String    @unique
  invitedBy   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, email])
}

/// Demande de devis (formule Sur mesure) ou de contact commercial — donnée PLATEFORME,
/// visible uniquement par le Super Admin (RLS), jamais par une entreprise.
model PlatformInquiry {
  id           String   @id @default(uuid())
  kind         String   @default("custom_plan") // custom_plan | contact
  fullName     String
  email        String
  phone        String?
  companyName  String?
  sectorKey    String?
  message      String
  status       String   @default("new") // new | contacted | closed
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model ImpersonationSession {
  id           String    @id @default(uuid())
  superAdminId String
  superAdmin   User      @relation("SuperAdminActor", fields: [superAdminId], references: [id])
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  targetUserId String?
  reason       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([tenantId])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String? // null = action strictement plateforme
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  actorUserId String?
  actorType   String // super_admin | owner | employee | system | customer
  action      String // ex. "order.status_changed"
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ============================================================================
// CATALOGUE
// ============================================================================

model Shop {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  region      String?
  department  String?
  commune     String?
  isMain      Boolean @default(true)
  isWarehouse Boolean @default(false)

  inventoryItems InventoryItem[]

  @@index([tenantId])
}

model Category {
  id       String     @id @default(uuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  name     String
  slug     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  imageUrl String?

  products Product[]

  @@unique([tenantId, slug])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  name              String
  slug              String
  description       String?
  shortDescription  String?
  sku               String?
  brand             String?
  status            ProductStatus @default(DRAFT)
  basePrice         Int
  compareAtPrice    Int?
  costPrice         Int?
  taxRate           Decimal       @default(0) @db.Decimal(5, 2)
  seoKeywords       String[]      @default([])
  tags              String[]      @default([])
  aiGenerated       Boolean       @default(false)
  aiGenerationJobId String?
  /// Faux = uniquement "retrait en boutique" possible pour cet article — voir étape 2,
  /// règle "panier mixte" : un seul article non livrable dans le panier force le mode
  /// pickup pour TOUTE la commande (pas de livraison scindée dans cette étape).
  isDeliverable     Boolean       @default(true)
  /// Vrai = ajoute `DeliveryZone.bulkySurcharge` au montant de livraison si présent
  /// dans le panier au moment du checkout.
  isBulky           Boolean       @default(false)
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  images    ProductImage[]
  variants  ProductVariant[]
  reviews   Review[]
  wishlists Wishlist[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku]) // NULL autorisé plusieurs fois (comportement natif Postgres) ; un SKU renseigné doit être unique PAR TENANT.
  @@index([tenantId, status])
}

model ProductImage {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  variantId    String?
  /// Référence la médiathèque réelle (voir MediaAsset.referenceCount) — jamais une simple
  /// URL en dur : ajoutée le 18 septembre 2026 (revue « catalogue réel ») pour qu'une image
  /// produit ne puisse jamais pointer vers un média déjà supprimé/étranger au tenant, et
  /// pour que la suppression d'un média encore utilisé par un produit soit détectée (même
  /// règle que l'éditeur visuel, voir apps/web/lib/editor/media-references.ts).
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  /// Dénormalisée au moment de la liaison (jamais recalculée à la volée) : l'URL publique
  /// vient du fournisseur de stockage (@yamacommerce/storage), pas de ce modèle — voir
  /// `addProductImage` dans catalog-registry.ts.
  url          String
  altText      String?
  position     Int         @default(0)

  @@index([mediaAssetId])
}

model ProductVariant {
  id          String  @id @default(uuid())
  /// Dénormalisé depuis `Product.tenantId` (revue du 18 septembre 2026, « corrections
  /// de sécurité ») — indispensable pour poser une policy RLS directe (Pattern A) sur
  /// cette table : le filtrage applicatif explicite via `product: { tenantId }` reste
  /// en place partout (défense en profondeur), mais ne doit jamais être la SEULE
  /// protection. Renseigné à la création par `catalog-registry.ts`, jamais recalculé
  /// après coup.
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String // ex. "Rouge / M"
  sku         String?
  price       Int
  costPrice   Int?
  barcode     String?
  weightGrams Int?
  volumeCm3   Int?
  attributes  Json    @default("{}") // { color, size, ... }

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@unique([tenantId, sku]) // NULL autorisé plusieurs fois (comportement natif Postgres) ; un SKU renseigné doit être unique PAR TENANT, jamais globalement.
  @@index([productId])
  @@index([tenantId])
}

model InventoryItem {
  id                String         @id @default(uuid())
  /// Dénormalisé depuis `ProductVariant.tenantId` — même justification que ci-dessus.
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  productVariantId  String
  variant           ProductVariant @relation(fields: [productVariantId], references: [id])
  shopId            String
  shop              Shop           @relation(fields: [shopId], references: [id])
  /// Quantité VENDABLE, déjà nette des réservations — `CHECK (availableQuantity >= 0)`
  /// posé par la migration. Renommé depuis `quantity` à l'étape 2 (clients/panier/
  /// commandes/livraison) pour porter la réservation atomique de commande : réserver
  /// transfère un delta LITTÉRAL vers `reservedQuantity` (jamais une comparaison de
  /// deux colonnes dans un WHERE, que Prisma ne permet pas nativement — voir
  /// order-registry.ts). Le stock physique total affiché est calculé à la volée
  /// (`availableQuantity + reservedQuantity`), jamais stocké séparément.
  availableQuantity Int            @default(0)
  reservedQuantity  Int            @default(0)
  lowStockThreshold Int            @default(5)

  movements StockMovement[]

  @@unique([productVariantId, shopId])
  @@index([tenantId])
}

model StockMovement {
  id              String        @id @default(uuid())
  /// Dénormalisé depuis `InventoryItem.tenantId` — même justification que ci-dessus.
  /// Table rendue IMMUABLE au niveau base (REVOKE UPDATE/DELETE pour le rôle
  /// applicatif, voir la migration) : l'historique des mouvements ne doit jamais
  /// pouvoir être modifié ou supprimé après coup, même par un bug applicatif.
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  type            String // in | out | adjustment | transfer | return
  quantity        Int
  reason          String?
  referenceType   String? // order | purchase | manual
  referenceId     String?
  performedBy     String?
  createdAt       DateTime      @default(now())

  @@index([tenantId])
}

model Supplier {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  phone    String?
  address  String?
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  category      String
  amount        Int
  description   String?
  date          DateTime
  attachmentUrl String?
  createdBy     String?
}

// ============================================================================
// CLIENTS
// ============================================================================

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  userId        String?
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  customerGroup String   @default("retail") // retail | wholesale | reseller
  loyaltyPoints Int      @default(0)
  referralCode  String?  @unique
  referredById  String?
  totalSpent    Int      @default(0)
  ordersCount   Int      @default(0)
  /// Notes internes visibles uniquement par l'équipe du tenant, jamais exposées au
  /// client — voir étape 2 (clients/panier/commandes/livraison), "fiche client".
  internalNotes String?
  createdAt     DateTime @default(now())

  addresses CustomerAddress[]
  orders    Order[]
  wishlists Wishlist[]
  reviews   Review[]
  carts     Cart[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CustomerAddress {
  id           String   @id @default(uuid())
  /// Dénormalisé depuis `Customer.tenantId` — RLS Pattern A posée à l'étape 2
  /// (durcissement des tables enfants existantes, même précédent que
  /// ProductVariant/InventoryItem/StockMovement : le filtrage applicatif via le parent
  /// reste en place en plus, défense en profondeur).
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  label        String?
  region       String
  department   String?
  commune      String?
  neighborhood String? // quartier
  street       String?
  geoLat       Float?
  geoLng       Float?
  isDefault    Boolean  @default(false)

  @@index([tenantId])
}

model Wishlist {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  status     String   @default("pending") // pending | approved | rejected
  response   String?
  createdAt  DateTime @default(now())
}

model PromoCode {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  code           String
  type           String // percentage | fixed | free_shipping
  value          Int
  minOrderAmount Int?
  usageLimit     Int?
  usageCount     Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?

  @@unique([tenantId, code])
}

model GiftCard {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  code         String    @unique
  initialValue Int
  balance      Int
  expiresAt    DateTime?
}

// ============================================================================
// PANIER (étape 2 — clients/panier/commandes/livraison, 19 septembre 2026)
// ============================================================================

/// Contrairement à `ProductVariant`/`InventoryItem`/`StockMovement` à leur création
/// initiale, cette table reçoit une VRAIE policy RLS Pattern A dès le départ — voir la
/// revue qui a exigé la correction de cet écart sur le catalogue : ne jamais livrer une
/// nouvelle table enfant sans isolation directe.
model Cart {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  /// Jeton opaque posé dans un cookie httpOnly côté visiteur non connecté (voir
  /// apps/web/lib/storefront/visitor-session.ts) tant qu'aucun client n'est résolu.
  /// Un même visiteur peut avoir plusieurs paniers dans le temps (un par session
  /// d'achat), mais au plus UN panier "active" à la fois — voir l'index unique partiel
  /// posé par la migration (non déclarable via `@@unique` : n'est valable QUE pour les
  /// lignes `status = 'active'`).
  visitorToken     String?
  status           String    @default("active") // active | converted | abandoned
  currency         String    @default("XOF")
  /// Renseigné UNIQUEMENT au moment de la conversion en commande — voir
  /// `order-registry.ts` `convertCartToOrder`. Combiné à la garde `status: "active"`
  /// sur l'UPDATE de conversion, c'est ce qui rend la création de commande idempotente
  /// face à une double soumission (rejeu → panier déjà "converted" → on renvoie la
  /// commande déjà créée au lieu d'en créer une seconde).
  convertedOrderId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items CartItem[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, visitorToken])
}

model CartItem {
  id               String         @id @default(uuid())
  /// Dénormalisé depuis `Cart.tenantId` — même précédent que ProductVariant/
  /// InventoryItem/StockMovement (RLS Pattern A directe, filtrage applicatif via le
  /// parent conservé en plus, défense en profondeur).
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  addedAt          DateTime       @default(now())

  @@unique([cartId, productVariantId])
  @@index([tenantId])
}

// ============================================================================
// COMMANDES
// ============================================================================

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

model Order {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  shopId               String?
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  orderNumber          String // séquentiel par tenant, ex. CMD-2026-000123
  status               OrderStatus   @default(NEW)
  channel              String        @default("web") // web | whatsapp | instore | phone
  paymentStatus        PaymentStatus @default(UNPAID)
  subtotal             Int
  discountTotal        Int           @default(0)
  shippingTotal        Int           @default(0)
  taxTotal             Int           @default(0)
  total                Int
  currency             String        @default("XOF")
  deliveryZoneId       String?
  deliveryAddressId    String?
  /// "delivery" (livraison à domicile/zone) | "pickup" (retrait en boutique) — voir
  /// étape 2, règle "panier mixte" : au moins un article `Product.isDeliverable = false`
  /// dans le panier force "pickup" pour toute la commande (pas de livraison scindée).
  deliveryMethod       String        @default("delivery")
  /// Renseigné UNIQUEMENT pour le chemin paiement en ligne (`AWAITING_PAYMENT`) — voir
  /// `order-reservation.ts`. Null pour une commande à la livraison (engagement ferme
  /// dès `CONFIRMED`, jamais auto-libérée) et remis à null dès que la commande quitte
  /// `AWAITING_PAYMENT` (payée ou annulée).
  ///
  /// `@db.Timestamptz(3)` DÉLIBÉRÉMENT explicite (le défaut Prisma/Postgres pour
  /// `DateTime` est `timestamp` SANS fuseau) : cette colonne est comparée à `NOW()` en
  /// SQL brut (voir order-reservation.ts, `releaseExpiredReservationTx`) — un
  /// `timestamp` sans fuseau aurait fait réinterpréter ses chiffres nus dans le
  /// fuseau de LA SESSION Postgres à chaque comparaison (ex. America/New_York sur
  /// l'instance de test), rendant une réservation réellement expirée invisible
  /// pendant des heures. `timestamptz` stocke un instant ABSOLU : la comparaison
  /// contre `NOW()` (également `timestamptz`) est alors correcte quel que soit le
  /// fuseau de session — voir `order-reservation.test.ts`, « MULTI-FUSEAUX », pour la
  /// preuve réelle avec plusieurs `SET TIME ZONE` différents.
  reservationExpiresAt DateTime?     @db.Timestamptz(3)
  /// Jeton opaque permettant à un visiteur invité (sans compte client) de revoir sa
  /// propre confirmation de commande sans authentification — voir le storefront.
  accessToken          String        @unique @default(uuid())
  notes                String?
  /// Moyen de paiement CHOISI au checkout (`cod`, `online`, `manual_wave`,
  /// `manual_orange_money`) — affichage et tri uniquement. Le statut réel du paiement
  /// reste `paymentStatus` + les lignes `Payment`, jamais ce champ.
  paymentMethod        String        @default("cod")
  /// Notes internes de l'équipe — jamais exposées au client (storefront, suivi).
  internalNotes        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  invoice       Invoice?
  delivery      Delivery?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id                  String         @id @default(uuid())
  /// Dénormalisé depuis `Order.tenantId` — RLS Pattern A posée à l'étape 2, même
  /// précédent que ProductVariant/InventoryItem/StockMovement.
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id])
  productVariantId    String
  variant             ProductVariant @relation(fields: [productVariantId], references: [id])
  productNameSnapshot String
  unitPrice           Int
  quantity            Int
  discount            Int            @default(0)
  taxRate             Decimal        @default(0) @db.Decimal(5, 2)
  total               Int

  @@index([tenantId])
}

model OrderStatusHistory {
  id            String       @id @default(uuid())
  /// Dénormalisé depuis `Order.tenantId` — RLS Pattern A. Table rendue IMMUABLE au
  /// niveau base (REVOKE UPDATE/DELETE, voir la migration) : une transition de statut
  /// ne doit jamais pouvoir être réécrite après coup, même par un bug applicatif —
  /// même garantie que `StockMovement`. Seul `transitionOrderStatus` (order-status.ts)
  /// écrit dans cette table, toujours par `create`.
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedBy     String?
  changedByType String // owner | employee | system | customer
  note          String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
}

// ============================================================================
// PAIEMENTS
// ============================================================================

model PaymentProviderConfig {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  provider  String // paydunya | paytech | cod | wave_direct | orange_money_direct
  isEnabled Boolean @default(false)
  mode      String  @default("sandbox") // sandbox | live
  label     String?
  /// Paiement MANUEL (`wave_direct`, `orange_money_direct`) — numéro du portefeuille
  /// marchand affiché au client pour qu'il envoie le montant exact. Donnée publique
  /// (le client doit la voir), jamais un secret : ne remplace pas les identifiants
  /// chiffrés ci-dessous, réservés aux prestataires automatiques (PSP).
  accountNumber      String?
  accountHolderName  String?
  publicInstructions String?

  // Identifiants du compte marchand du tenant, chiffrés au repos (AES-256-GCM).
  // Adjustement #4 : chaque entreprise peut connecter son propre compte marchand ;
  // le texte en clair ne doit JAMAIS être journalisé ni renvoyé par une API.
  // Voir packages/database/src/encryption.ts.
  credentialsCiphertext String?
  credentialsIv         String?
  credentialsAuthTag    String?
  connectedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, provider])
}

enum PaymentTxStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String          @id @default(uuid())
  tenantId              String
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  provider              String
  providerTransactionId String?         @unique
  idempotencyKey        String          @unique
  amount                Int
  currency              String          @default("XOF")
  status                PaymentTxStatus @default(PENDING)
  type                  String          @default("full") // full | partial | installment
  rawPayload            Json?
  verifiedAt            DateTime?
  // Rapprochement commande ↔ paiement ↔ facture (adjustement #3)
  reconciliationStatus  String          @default("pending") // pending | matched | mismatched
  reconciledAt          DateTime?
  /// Paiement MANUEL (Wave/Orange Money direct) — preuve déclarée par le client,
  /// jamais une confirmation : seul un membre de l'équipe du tenant avec
  /// `payments.view` + `orders.update_status` peut valider (voir
  /// `manual-payment-registry.ts`). Une preuve déposée laisse la commande
  /// `AWAITING_PAYMENT`, jamais `PAID`.
  proofReference        String?
  proofImageUrl         String?
  proofSubmittedAt      DateTime?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime        @default(now())

  @@index([tenantId, status])
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  /// Ajouté à l'étape 2 (clients/panier/commandes/livraison) : jusque-là cette table
  /// n'avait aucun `tenantId` (le tenant était résolu via l'URL de callback, jamais
  /// stocké) et aucune route HTTP ne l'atteignait réellement — cette étape construit la
  /// première (`/api/webhooks/[provider]/[tenantId]`), donc la table est prouvée vide
  /// et le NOT NULL ne nécessite aucun backfill. RLS Pattern A comme le reste des
  /// tables paiement.
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  provider    String
  eventId     String // identifiant fourni par le prestataire — clé d'idempotence
  payload     Json
  status      String    @default("received") // received | processed | ignored | error
  // Relance automatique des traitements échoués (adjustement #3)
  retryCount  Int       @default(0)
  nextRetryAt DateTime?
  lastError   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, nextRetryAt])
  @@index([tenantId])
}

model InstallmentPlan {
  id           String        @id @default(uuid())
  orderId      String        @unique
  totalAmount  Int
  installments Installment[]
}

model Installment {
  id                String          @id @default(uuid())
  installmentPlanId String
  plan              InstallmentPlan @relation(fields: [installmentPlanId], references: [id])
  dueDate           DateTime
  amount            Int
  status            String          @default("pending") // pending | paid | overdue
  paidPaymentId     String?
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Counter {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  scope    String // ex. "invoice-2026", "order-2026"
  value    Int    @default(0)

  @@unique([tenantId, scope])
}

model Invoice {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  orderId          String?       @unique
  order            Order?        @relation(fields: [orderId], references: [id])
  number           String // séquentiel par tenant ET par exercice, ex. FAC-2026-000045
  fiscalYear       Int
  type             String        @default("invoice") // invoice | deposit_invoice | final_invoice
  status           String        @default("draft") // draft | finalized | canceled
  issueDate        DateTime      @default(now())
  dueDate          DateTime?
  customerSnapshot Json
  itemsSnapshot    Json
  subtotal         Int
  discountTotal    Int           @default(0)
  taxTotal         Int
  total            Int
  paymentStatus    PaymentStatus @default(UNPAID)
  qrCodeToken      String        @unique
  pdfUrl           String?
  // Immutabilité (adjustement #6) : une fois finalizedAt renseigné, plus aucune mutation
  // des champs de contenu n'est autorisée par la couche applicative — seule la création
  // d'un CreditNote peut corriger une facture finalisée.
  finalizedAt      DateTime?
  integrityHash    String?

  creditNotes CreditNote[]

  @@unique([tenantId, number])
  @@index([tenantId, fiscalYear])
}

model CreditNote {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  number    String
  reason    String
  amount    Int
  pdfUrl    String?
  createdAt DateTime @default(now())
}

model Quote {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  customerId    String
  number        String
  status        String    @default("draft") // draft | sent | accepted | rejected | expired
  itemsSnapshot Json
  total         Int
  validUntil    DateTime?
  pdfUrl        String?

  @@unique([tenantId, number])
}

model DeliveryNote {
  id           String    @id @default(uuid())
  orderId      String    @unique
  number       String
  pdfUrl       String?
  signedBy     String?
  signatureUrl String?
  deliveredAt  DateTime?
}

model Refund {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String
  paymentId   String
  amount      Int
  reason      String?
  status      String   @default("pending")
  processedBy String?
  createdAt   DateTime @default(now())
}

// ============================================================================
// LIVRAISON
// ============================================================================

model DeliveryZone {
  id             String  @id @default(uuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  /// Nom affiché au client (ex. « Dakar Plateau — express »). Null = libellé dérivé
  /// de la région/commune.
  name           String?
  isActive       Boolean @default(true)
  /// Catégories exclues de cette zone (ex. produits fragiles ou encombrants non
  /// livrables hors Dakar) : un panier contenant un article d'une de ces catégories
  /// ne peut pas choisir cette zone — recalculé côté serveur (`quoteDelivery`).
  excludedCategoryIds String[] @default([])
  region         String
  department     String?
  commune        String?
  neighborhood   String?
  fee            Int
  freeThreshold  Int?
  /// Supplément ajouté au montant de livraison si le panier contient au moins un
  /// article `Product.isBulky` — voir étape 2.
  bulkySurcharge Int     @default(0)
  estimatedDays  Int?
}

model Deliverer {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  userId      String?
  phone       String
  vehicleType String?
  isActive    Boolean @default(true)

  deliveries Delivery[]
}

model Delivery {
  id                 String     @id @default(uuid())
  /// Dénormalisé depuis `Order.tenantId` — RLS Pattern A posée à l'étape 2, même
  /// précédent que ProductVariant/InventoryItem/StockMovement.
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  orderId            String     @unique
  order              Order      @relation(fields: [orderId], references: [id])
  delivererId        String?
  deliverer          Deliverer? @relation(fields: [delivererId], references: [id])
  status             String     @default("assigned") // assigned | picked_up | in_transit | delivered | failed
  proofType          String? // photo | signature | code
  proofUrl           String?
  codAmountCollected Int?
  codRemittedAt      DateTime?
  createdAt          DateTime   @default(now())

  @@index([tenantId])
}

model DelivererRemittance {
  id          String   @id @default(uuid())
  delivererId String
  amount      Int
  remittedAt  DateTime @default(now())
  confirmedBy String?
}

// ============================================================================
// IA (adjustement #8 : quotas par formule, historique, validation humaine)
// ============================================================================

model AIGenerationJob {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  type            String // product_from_photo | product_from_text | bulk_import | translation | marketing_copy | chat_query
  status          String    @default("pending") // pending | processing | completed | failed
  inputPayload    Json
  outputPayload   Json?
  model           String?
  imagesCount     Int       @default(0)
  costEstimateXOF Int       @default(0)
  createdBy       String?
  createdAt       DateTime  @default(now())
  // Aucun contenu IA n'est publiable sans validation humaine explicite.
  reviewedAt      DateTime?
  reviewedBy      String?
  approved        Boolean   @default(false)

  @@index([tenantId, createdAt])
}

/// Compteur d'utilisation IA par tenant et par période mensuelle (YYYY-MM),
/// vérifié avant chaque nouvelle génération pour appliquer les limites du Plan.
model AIUsageRecord {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  periodMonth          String // "2026-09"
  generationsUsed      Int      @default(0)
  imagesAnalyzedUsed   Int      @default(0)
  productsImportedUsed Int      @default(0)
  estimatedCostXOF     Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, periodMonth])
}

model ImportJob {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  sourceType      String // csv | excel | pdf | url | photos
  sourceUrl       String?
  fileUrl         String?
  mimeType        String?
  sizeBytes       Int?
  // Sécurisation des imports URL/PDF (adjustement #9)
  urlHostAllowed  Boolean? // résultat de la vérification anti-SSRF (liste blanche / résolution IP)
  virusScanStatus String   @default("not_applicable") // not_applicable | pending | clean | infected | error
  status          String   @default("pending") // pending | processing | completed | failed
  totalRows       Int?
  processedRows   Int      @default(0)
  errorLog        Json?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([tenantId, status])
}

// ============================================================================
// NOTIFICATIONS (adjustement #7 : WhatsApp multi-tenant, pas de numéro central)
// ============================================================================

/// Connexion WhatsApp Business Cloud API propre à chaque tenant. Aucune valeur
/// par défaut ne pointe vers un numéro plateforme partagé : tant que ce modèle
/// n'existe pas pour un tenant, les notifications WhatsApp sont simplement désactivées.
model WhatsAppConfig {
  id                    String    @id @default(uuid())
  tenantId              String    @unique
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  wabaId                String? // WhatsApp Business Account ID du tenant
  phoneNumberId         String?
  displayPhoneNumber    String?
  accessTokenCiphertext String?
  accessTokenIv         String?
  accessTokenAuthTag    String?
  verified              Boolean   @default(false)
  connectedAt           DateTime?
}

model NotificationTemplate {
  id           String  @id @default(uuid())
  tenantId     String? // null = modèle par défaut plateforme
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
  type         String // order_confirmed | payment_failed | ...
  channel      String // email | sms | whatsapp | internal
  locale       String  @default("fr")
  subject      String?
  bodyTemplate String
  isCustomized Boolean @default(false)

  @@unique([tenantId, type, channel, locale])
}

// ============================================================================
// PLATEFORME / FACTURATION INTERNE
// ============================================================================

model Commission {
  id               String   @id @default(uuid())
  tenantId         String
  orderId          String
  rate             Decimal  @db.Decimal(5, 2)
  amount           Int
  invoicedToTenant Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(uuid())
  tenantId  String?
  level     String // info | warning | error | critical
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

/// Réglages de vente d'un tenant — retrait en boutique, instructions, commande
/// invitée, fenêtre de paiement manuel. Une ligne au plus par tenant ; absente =
/// valeurs par défaut (voir `getCommerceSettings`).
model CommerceSettings {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  pickupEnabled            Boolean  @default(true)
  pickupAddress            String?
  pickupInstructions       String?
  deliveryInstructions     String?
  guestCheckoutEnabled     Boolean  @default(true)
  /// Durée (heures) pendant laquelle le stock reste réservé pour une commande en
  /// paiement manuel (Wave/Orange Money) avant expiration automatique.
  manualPaymentWindowHours Int      @default(24)
  updatedAt                DateTime @updatedAt
}

/// Journal HONNÊTE des notifications — distingue « événement créé / mis en file »
/// (`queued`) d'une livraison réellement réussie (`sent`), échouée (`failed`) ou
/// impossible faute de fournisseur configuré (`not_sent_no_provider`). Jamais un
/// envoi présenté comme réussi sans réponse positive d'un fournisseur réel.
model NotificationLog {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  orderId   String?
  event     String
  channel   String
  recipient String?
  status    String    @default("queued")
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, orderId])
}
