# Sauvegardes de la prévisualisation — copier en /etc/ycom-backup/backup.env (root, 600).
# Jamais dans le dépôt, jamais dans une conversation. Voir docs/19-securite-previsualisation.md.

# Dossier du dépôt sur le serveur (docker compose y est lancé).
REPO_DIR=/home/ycom/SAAS
# Dépôt restic HORS du serveur. Hetzner Storage Box (SFTP, port 23) :
#   sftp://uXXXXXX@uXXXXXX.your-storagebox.de:23/ycom-preview
RESTIC_REPOSITORY=
# Mot de passe de chiffrement (openssl rand -base64 32). À GARDER AUSSI hors du serveur
# (gestionnaire de mots de passe) : sans lui, les sauvegardes sont illisibles.
RESTIC_PASSWORD=
# Clé SSH dédiée à la Storage Box et empreinte connue du serveur distant.
SSH_KEY=/etc/ycom-backup/storagebox_ed25519
KNOWN_HOSTS=/etc/ycom-backup/known_hosts
# Surveillance (healthchecks.io) : une URL par contrôle ; vide = pas d'alerte.
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_RESTORE_URL=
