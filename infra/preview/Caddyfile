{
	# Certificats des sous-domaines émis à la demande, uniquement pour ceux que Y-COM
	# reconnaît (entreprises de démonstration actives).
	on_demand_tls {
		ask http://web:3000/api/domains/ask
	}
}

# Domaine de la plateforme (connexion, tableau de bord, studio) : certificat classique,
# demandé au démarrage — il n'est pas un domaine d'entreprise, `ask` le refuserait.
{$PREVIEW_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

# Sites des entreprises de démonstration.
*.{$PREVIEW_DOMAIN} {
	tls {
		on_demand
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}
