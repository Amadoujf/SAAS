# Prévisualisation privée — copier en .env.preview (jamais versionné) et renseigner.
# Domaine : sous-domaine de l'adresse IP du serveur via sslip.io (aucun achat de domaine),
# ex. 203-0-113-10.sslip.io, ou un sous-domaine à vous (preview.exemple.sn) avec un
# enregistrement DNS joker *.preview.exemple.sn → IP du serveur.
PREVIEW_DOMAIN=
# Code d'accès communiqué aux personnes invitées (long, aléatoire : openssl rand -base64 18).
PREVIEW_ACCESS_CODE=
# Secrets générés sur le serveur (openssl rand -hex 32), jamais dans le dépôt.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
AUTH_SECRET=
ENCRYPTION_KEY=
# Mot de passe des comptes de démonstration (remplace celui, public, des scripts de démo).
PREVIEW_DEMO_PASSWORD=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# IA réelle : clé Anthropic (console.anthropic.com), saisie ICI sur le serveur uniquement.
# Sans clé, l'assistant indique qu'il n'est pas configuré (aucune simulation en production).
AI_PROVIDER_API_KEY=
AI_MODEL=claude-opus-5-5
# Plafond mensuel de dépenses IA estimées de toute la prévisualisation, en FCFA
# (défaut 15000). Régler AUSSI une limite de dépenses dans la console Anthropic.
AI_PLATFORM_MONTHLY_CAP_XOF=15000
# Facultatif : e-mails réels (sinon les notifications restent « non envoyées — aucun fournisseur »).
RESEND_API_KEY=
EMAIL_FROM=
