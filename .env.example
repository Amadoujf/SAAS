# ============================================================================
# Y-COM — variables d'environnement
# Copiez ce fichier en `.env` à la racine du monorepo et renseignez de vraies valeurs.
# Ne JAMAIS committer un fichier .env contenant de vrais secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------------
# Connexion utilisée par Prisma Client à l'exécution (application + tests) : un rôle
# NON superutilisateur, sans BYPASSRLS — c'est cette connexion qui est réellement
# protégée par les policies Row-Level Security. Voir la migration
# *_enable_row_level_security et docs/03-architecture-technique.md §3.2.
DATABASE_URL="postgresql://yamacommerce_app:change-me-in-production@localhost:5432/yamacommerce?schema=public"

# Connexion utilisée UNIQUEMENT par `prisma migrate` / `prisma studio` (propriétaire des
# tables, ou superutilisateur) — voir la directive `directUrl` du datasource Prisma.
# Ne jamais utiliser cette URL depuis le code applicatif.
MIGRATE_DATABASE_URL="postgresql://yamacommerce_owner:change-me-in-production@localhost:5432/yamacommerce?schema=public"

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Laisser vide/absent en local : si PostgreSQL est injoignable, le test d'isolation
# multi-tenant est simplement ignoré (skip) plutôt que de faire échouer `pnpm test`.
# La CI (voir .github/workflows/ci.yml) force cette variable à "true" : dans cet
# environnement, une base injoignable doit faire ÉCHOUER le test, jamais le sauter
# silencieusement — voir packages/database/tests/tenant-isolation.test.ts.
REQUIRE_DB_TESTS=

# ---------------------------------------------------------------------------
# Authentification (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Générez avec : npx auth secret   (ou `openssl rand -base64 32`)
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-de-32-octets-minimum"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Chiffrement des identifiants de compte marchand (PayDunya/PayTech/WhatsApp)
# ---------------------------------------------------------------------------
# Clé AES-256 en hexadécimal (64 caractères). Générez avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="remplacez-moi-par-64-caracteres-hexadecimaux"

# ---------------------------------------------------------------------------
# Paiements — PayDunya (premier prestataire actif, mode sandbox)
# ---------------------------------------------------------------------------
# Ces clés sont les identifiants PLATEFORME utilisés pour les tenants qui n'ont pas
# connecté leur propre compte marchand (formules Essentiel/Business). Un tenant
# Entreprise peut fournir ses propres clés, chiffrées et stockées dans
# PaymentProviderConfig — voir packages/payments/src/registry.ts.
PAYDUNYA_MODE="sandbox"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""

# PayTech sera ajouté comme second prestataire (Phase 2) — variables réservées :
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""

# ---------------------------------------------------------------------------
# Facturation SaaS — Chariow (packages/billing, voir docs/14)
# ---------------------------------------------------------------------------
# Concerne UNIQUEMENT l'abonnement des entreprises à la plateforme elle-même — jamais
# les paiements de leurs commandes clientes (voir PAYDUNYA_*/PAYTECH_* ci-dessus,
# packages/payments, strictement séparé). "manual" par défaut : aucun appel réseau
# réel, adaptateur utilisé par les tests et les interventions Super Admin manuelles.
SAAS_BILLING_PROVIDER="manual"
CHARIOW_SECRET_KEY=""
CHARIOW_WEBHOOK_SECRET=""
CHARIOW_API_BASE_URL="https://api.chariow.com"

# ---------------------------------------------------------------------------
# Email transactionnel (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="no-reply@yamacommerce.ai"

# ---------------------------------------------------------------------------
# Stockage fichiers (Cloudflare R2, compatible S3)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="yamacommerce-uploads"

# ---------------------------------------------------------------------------
# Domaines personnalisés — fournisseur DNS/TLS (voir packages/domains)
# ---------------------------------------------------------------------------
# "caddy" (on-demand TLS, premiers déploiements) ou "cloudflare_custom_hostname".
DOMAIN_PROVIDER="caddy"
# Chemin du dossier de données Caddy (`storage`, ex. /data/caddy dans un volume
# PARTAGÉ entre le conteneur `web` et le conteneur `caddy`) — utilisé UNIQUEMENT par
# `CaddyDomainProvider.revokeDomain` pour supprimer le certificat mis en cache d'un
# domaine suspendu/retiré (voir la revue du 18 septembre 2026 : sans ce chemin, un
# certificat déjà émis reste actif en HTTPS malgré la suspension, jusqu'à son
# renouvellement naturel). Laisser vide si `web` et Caddy ne partagent pas de volume —
# un avertissement est alors journalisé plutôt qu'une révocation silencieusement
# ignorée. Sans effet avec DOMAIN_PROVIDER=cloudflare_custom_hostname (révocation
# réelle via l'API Cloudflare, pas de fichiers à supprimer).
CADDY_CERT_STORAGE_PATH=""

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API — connexion PAR TENANT (adjustement #7)
# ---------------------------------------------------------------------------
# Ces identifiants sont ceux de l'app Meta utilisée pour l'onboarding "Embedded
# Signup" : ils permettent à CHAQUE tenant de connecter SON PROPRE numéro WhatsApp
# Business (stocké chiffré dans WhatsAppConfig). Il n'existe aucun numéro central
# partagé entre tenants.
WHATSAPP_META_APP_ID=""
WHATSAPP_META_APP_SECRET=""

# ---------------------------------------------------------------------------
# SMS (OTP, notifications critiques)
# ---------------------------------------------------------------------------
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---------------------------------------------------------------------------
# IA (assistant « Mon site », voir docs/15-integrations-et-configuration.md)
# ---------------------------------------------------------------------------
# Clé API Anthropic : présente = génération réelle. À renseigner dans les secrets de
# l'hébergeur, jamais dans le code.
AI_PROVIDER_API_KEY=""
# Facultatif : modèle (défaut claude-opus-5-5) et taux USD→FCFA pour l'estimation des coûts.
AI_MODEL=""
AI_USD_TO_XOF="610"
# Développement uniquement : « simulated » = règles locales étiquetées « simulation »
# (refusé en production).
AI_PROVIDER=""

# ---------------------------------------------------------------------------
# Internationalisation / localisation
# ---------------------------------------------------------------------------
DEFAULT_LOCALE="fr"
SUPPORTED_LOCALES="fr,en,wo"
DEFAULT_CURRENCY="XOF"
DEFAULT_TIMEZONE="Africa/Dakar"

# ---------------------------------------------------------------------------
# Amorçage (seed) — Super Admin de démonstration
# ---------------------------------------------------------------------------
SUPERADMIN_SEED_EMAIL="superadmin@yamacommerce.ai"
SUPERADMIN_SEED_PASSWORD="ChangeMoi!2026"

NODE_ENV="development"

# Lien d'aide affiché dans l'espace entreprise (https uniquement). Vide : la carte d'aide mène aux « premiers pas ».
SUPPORT_URL=
